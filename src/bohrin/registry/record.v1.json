{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bohrin.com/schema/registry-record/v1",
  "title": "Bohrin registry record",
  "description": "One public record of a defect in a coding grader or its harness, with the proof a stranger needs to check it. Field names follow the OSV schema (https://ossf.github.io/osv-schema/) where they fit. A record is published only under the notification policy in docs/disclosure.md; the date rule it states is checked by bohrin.registry.read_record beyond this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "id",
    "modified",
    "published",
    "summary",
    "weakness",
    "affected",
    "status",
    "numbering_authority",
    "disclosure"
  ],
  "properties": {
    "$schema": {
      "const": "https://bohrin.com/schema/registry-record/v1"
    },
    "schema_version": {
      "description": "The version of this record format, SemVer 2.0.0 without a leading v, as in OSV.",
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^BVR-[0-9]{4}-[0-9]{5,}$"
    },
    "aliases": {
      "description": "IDs of the same defect in other databases (OSV).",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "related": {
      "description": "IDs of closely related records (OSV).",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "modified": {
      "$ref": "#/$defs/timestamp"
    },
    "published": {
      "$ref": "#/$defs/timestamp"
    },
    "withdrawn": {
      "$ref": "#/$defs/timestamp"
    },
    "summary": {
      "description": "One line a reader can forward without editing.",
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "details": {
      "description": "The mechanism, in Markdown. Names the artefact, never a person.",
      "type": "string",
      "minLength": 1
    },
    "weakness": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^BGW-[1-9][0-9]*$"
      }
    },
    "probe": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*/[a-z0-9]+(-[a-z0-9]+)*@[1-9][0-9]*$"
    },
    "findings": {
      "description": "The finding records (https://bohrin.com/schema/finding/v1) this record is built on.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^BF-[0-9A-HJKMNP-TV-Z]{10}$"
      }
    },
    "affected": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/affected"
      }
    },
    "submission": {
      "description": "What was submitted, as a digest: the same definition as the finding record's. The submission itself is never published.",
      "$ref": "#/$defs/submission"
    },
    "score_received": {
      "description": "What the grader paid for the submission.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reward",
        "passed"
      ],
      "properties": {
        "reward": {
          "type": "number"
        },
        "passed": {
          "type": "boolean"
        }
      }
    },
    "ground": {
      "enum": [
        "structural",
        "differential",
        "invariant"
      ]
    },
    "reproduce": {
      "description": "The standalone reproduction script, as in the finding record.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script",
        "sha256"
      ],
      "properties": {
        "script": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "status": {
      "enum": [
        "reported",
        "confirmed",
        "fixed",
        "disputed",
        "withdrawn"
      ]
    },
    "numbering_authority": {
      "description": "Who assigned the ID.",
      "type": "string",
      "minLength": 1
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maintainer_notified"
      ],
      "properties": {
        "maintainer_notified": {
          "description": "When the maintainer was first told, privately.",
          "$ref": "#/$defs/timestamp"
        },
        "maintainer_agreed_early": {
          "description": "The maintainer agreed to publication before 45 days, after shipping a fix.",
          "type": "boolean"
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "url"
        ],
        "properties": {
          "type": {
            "enum": [
              "ADVISORY",
              "ARTICLE",
              "DETECTION",
              "DISCUSSION",
              "REPORT",
              "FIX",
              "INTRODUCED",
              "GIT",
              "PACKAGE",
              "EVIDENCE",
              "WEB"
            ]
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          }
        }
      }
    },
    "credits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "contact": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "type": {
            "enum": [
              "FINDER",
              "REPORTER",
              "ANALYST",
              "COORDINATOR",
              "REMEDIATION_DEVELOPER",
              "REMEDIATION_REVIEWER",
              "REMEDIATION_VERIFIER",
              "TOOL",
              "SPONSOR",
              "OTHER"
            ]
          }
        }
      }
    }
  },
  "if": {
    "properties": {
      "status": {
        "const": "withdrawn"
      }
    },
    "required": [
      "status"
    ]
  },
  "then": {
    "required": [
      "withdrawn"
    ]
  },
  "else": {
    "not": {
      "required": [
        "withdrawn"
      ]
    }
  },
  "$defs": {
    "timestamp": {
      "description": "RFC 3339, in UTC, ending in Z (OSV).",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "affected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "shape"
      ],
      "properties": {
        "artifact": {
          "description": "What has the defect: an environment, benchmark, grader or harness. Never a person.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "enum": [
                "environment",
                "benchmark",
                "grader",
                "harness"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "repository": {
              "type": "string",
              "pattern": "^https?://"
            }
          }
        },
        "shape": {
          "enum": [
            "program",
            "io",
            "workspace",
            "container",
            "history",
            "numeric",
            "proof",
            "query"
          ]
        },
        "ranges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/range"
          }
        },
        "versions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "range": {
      "description": "An OSV range: a version ordering and the events on it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "events"
      ],
      "properties": {
        "type": {
          "enum": [
            "GIT",
            "SEMVER",
            "ECOSYSTEM"
          ]
        },
        "repo": {
          "type": "string",
          "pattern": "^https?://"
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/event"
          }
        }
      },
      "if": {
        "properties": {
          "type": {
            "const": "GIT"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "repo"
        ]
      }
    },
    "event": {
      "description": "Exactly one of introduced, fixed, last_affected or limit (OSV).",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "introduced"
          ],
          "properties": {
            "introduced": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "fixed"
          ],
          "properties": {
            "fixed": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "last_affected"
          ],
          "properties": {
            "last_affected": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "limit"
          ],
          "properties": {
            "limit": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "submission": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "sha256"
          ],
          "properties": {
            "kind": {
              "const": "source"
            },
            "sha256": {
              "$ref": "#/$defs/digest"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "kind",
            "files",
            "commands",
            "parameters"
          ],
          "properties": {
            "kind": {
              "const": "workspace"
            },
            "files": {
              "type": "object",
              "additionalProperties": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/digest"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "commands": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "parameters": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
